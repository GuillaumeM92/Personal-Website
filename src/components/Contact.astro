---
import Icon from './Icon.astro';
import { ui, links, paths, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].contact;
---

<section class="section" id={ui[lang].ids.contact}>
  <div class="wrap">
    <div class="panel card reveal">
      <div class="main">
        <p class="kicker">{t.kicker}</p>
        <h2 class="section-title">{t.title}</h2>
        <p class="lead">{t.body}</p>

        <div class="mail">
          <a class="address" href={`mailto:${links.email}`}>{links.email}</a>
          <div class="mail-actions">
            <a class="btn btn-primary" href={`mailto:${links.email}`}>
              <Icon name="mail" />
              {t.email}
            </a>
            <button class="btn" type="button" data-copy={links.email} data-copied={t.copied}>
              <Icon name="copy" />
              <span>{t.copy}</span>
            </button>
          </div>
        </div>
      </div>

      <div class="side">
        <a class="row" href={links.linkedin} target="_blank" rel="me noopener">
          <Icon name="linkedin" />
          <span><strong>LinkedIn</strong><small>guillaume-merle</small></span>
          <Icon name="external" class="go" />
        </a>
        <a class="row" href={links.github} target="_blank" rel="me noopener">
          <Icon name="github" />
          <span><strong>GitHub</strong><small>GuillaumeM92</small></span>
          <Icon name="external" class="go" />
        </a>
        <div class="cv">
          <p>{t.cvTitle}</p>
          <div class="cv-actions">
            <a class="btn btn-small" href={paths[lang].cv}>
              <Icon name="file" />
              {t.cvView}
            </a>
            <a class="btn btn-small" href={paths[lang].pdf} download>
              <Icon name="download" />
              {t.cvPdf}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('span');
    const initial = label?.textContent ?? '';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        if (label) label.textContent = btn.dataset.copied!;
        setTimeout(() => label && (label.textContent = initial), 2000);
      } catch {
        location.href = `mailto:${btn.dataset.copy}`;
      }
    });
  });
</script>

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(1.5rem, 5vw, 3.5rem);
    overflow: hidden;
    background:
      radial-gradient(40rem 20rem at 0% 0%, rgb(56 214 224 / 0.12), transparent 60%),
      var(--panel);
    border-color: rgb(56 214 224 / 0.25);
  }

  .main {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .mail {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .address {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4.4vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(90deg, var(--ink), var(--accent-strong));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .mail-actions,
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .side {
    display: grid;
    gap: 0.75rem;
    align-content: center;
  }

  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(4 8 15 / 0.5);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s var(--ease);
  }

  .row:hover {
    border-color: var(--accent);
    transform: translateX(3px);
  }

  .row :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .row :global(.go) {
    width: 1rem;
    height: 1rem;
    color: var(--muted);
  }

  .row span {
    display: grid;
    line-height: 1.3;
  }

  .row small {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .cv {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .cv p {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 880px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }
</style>
