---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import shipIcon from '../assets/petit-vaisseau-icon.svg?raw';
import { ui } from '../data/content';

const fr = ui.fr.notFound;
const en = ui.en.notFound;
---

<Base lang="fr" title={`404 · ${fr.title}`} description={fr.body} alternate="/en/" noindex>
  <main id="main" class="lost">
    <div class="ship" aria-hidden="true" set:html={shipIcon} />
    <p class="code">404</p>
    <h1>{fr.title}</h1>
    <p>{fr.body}</p>
    <p class="en" lang="en">{en.title}. {en.body}</p>
    <div class="actions">
      <a class="btn btn-primary" href="/"><Icon name="back" />{fr.cta}</a>
      <a class="btn" href="/en/" lang="en">{en.cta}</a>
    </div>
  </main>
</Base>

<style>
  .lost {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    min-height: 100vh;
    padding: 3rem var(--gutter);
    text-align: center;
  }

  .ship {
    width: 5rem;
    margin-bottom: 1rem;
    filter: drop-shadow(0 0 22px rgb(56 214 224 / 0.55));
    animation: drift 6s ease-in-out infinite;
  }

  .ship :global(svg) {
    width: 100%;
    height: auto;
  }

  @keyframes drift {
    50% {
      transform: translate(6px, -10px) rotate(8deg);
    }
  }

  .code {
    font-family: var(--font-mono);
    letter-spacing: 0.3em;
    color: var(--accent);
  }

  h1 {
    font-size: clamp(2.2rem, 7vw, 3.5rem);
  }

  p {
    max-width: 30rem;
    color: var(--ink-soft);
  }

  .en {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1rem;
  }
</style>
