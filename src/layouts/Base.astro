---
import '../styles/global.css';
import { ui, paths, type Lang } from '../data/content';
import ogImage from '../assets/og-cover.jpg';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Page équivalente dans l'autre langue. */
  alternate: string;
  stars?: boolean;
  noindex?: boolean;
}

const { lang, title, description, alternate, stars = true, noindex = false } = Astro.props;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const alternateUrl = new URL(alternate, site).href;
const frUrl = lang === 'fr' ? canonical : alternateUrl;
const enUrl = lang === 'en' ? canonical : alternateUrl;
const og = new URL(ogImage.src, site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Guillaume Merle" />
    <meta name="theme-color" content="#04080f" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Guillaume Merle" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body data-lang={lang} data-other-home={paths[other].home}>
    <a class="skip-link" href="#main">{ui[lang].skip}</a>
    {stars && <canvas class="starfield" aria-hidden="true"></canvas>}
    <slot />

    <script>
      // --- Apparition au défilement ---
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // --- Champ d'étoiles ---
      const canvas = document.querySelector<HTMLCanvasElement>('canvas.starfield');
      const ctx = canvas?.getContext('2d');
      if (canvas && ctx) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        type Star = { x: number; y: number; z: number; r: number; tw: number; hue: number };
        let stars: Star[] = [];
        let w = 0;
        let h = 0;
        let raf = 0;
        let scrollY = window.scrollY;

        const resize = () => {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          w = window.innerWidth;
          h = window.innerHeight;
          canvas.width = Math.round(w * dpr);
          canvas.height = Math.round(h * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          const count = Math.round(Math.min(260, (w * h) / 6500));
          stars = Array.from({ length: count }, () => {
            const z = Math.random();
            return {
              x: Math.random() * w,
              y: Math.random() * h,
              z,
              r: 0.35 + z * 1.15,
              tw: Math.random() * Math.PI * 2,
              hue: Math.random() < 0.12 ? 1 : Math.random() < 0.06 ? 2 : 0,
            };
          });
        };

        const colors = ['220, 236, 244', '122, 232, 239', '255, 170, 140'];

        const draw = (t: number) => {
          ctx.clearRect(0, 0, w, h);
          for (const s of stars) {
            // Parallaxe : les étoiles proches (z élevé) défilent plus vite.
            const y = (((s.y - scrollY * (0.03 + s.z * 0.12)) % h) + h) % h;
            const x = reduce.matches ? s.x : (s.x + t * 0.004 * (0.2 + s.z)) % w;
            const a = 0.35 + 0.45 * s.z + (reduce.matches ? 0 : Math.sin(t * 0.0012 + s.tw) * 0.2);
            ctx.beginPath();
            ctx.arc(x, y, s.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(${colors[s.hue]}, ${Math.max(0.08, Math.min(1, a))})`;
            ctx.fill();
          }
        };

        const loop = (t: number) => {
          draw(t);
          raf = requestAnimationFrame(loop);
        };

        const start = () => {
          cancelAnimationFrame(raf);
          if (reduce.matches) draw(0);
          else raf = requestAnimationFrame(loop);
        };

        resize();
        start();
        let resizeTimer = 0;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(() => {
            resize();
            start();
          }, 150);
        });
        window.addEventListener(
          'scroll',
          () => {
            scrollY = window.scrollY;
            if (reduce.matches) draw(0);
          },
          { passive: true },
        );
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) cancelAnimationFrame(raf);
          else start();
        });
        reduce.addEventListener('change', start);
      }
    </script>

    <style>
      .starfield {
        position: fixed;
        inset: 0;
        z-index: -1;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }

      body {
        background:
          radial-gradient(70rem 40rem at 85% -10%, rgb(56 214 224 / 0.09), transparent 60%),
          radial-gradient(50rem 30rem at -10% 40%, rgb(255 122 77 / 0.05), transparent 60%),
          var(--bg);
        background-attachment: fixed;
      }
    </style>
  </body>
</html>
