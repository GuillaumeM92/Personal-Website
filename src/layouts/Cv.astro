---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import portrait from '../assets/portrait.png';
import { ui, links, paths, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const t = ui[lang];
const c = t.cvPage;
const jobs = t.experience.items.slice(0, 3);
const school = t.experience.items[3];
const site = 'guillaume-merle.fr';
---

<Base lang={lang} title={c.title} description={t.metaDescription} alternate={paths[other].cv} stars={false}>
  <div class="toolbar" data-print-hide>
    <a class="btn btn-small" href={paths[lang].home}><Icon name="back" />{c.back}</a>
    <div class="tools">
      <a class="btn btn-small lang" href={paths[other].cv} hreflang={other} lang={other}>{t.otherLang}</a>
      <button class="btn btn-small" type="button" onclick="window.print()"><Icon name="printer" />{c.print}</button>
      <a class="btn btn-small btn-primary" href={paths[lang].pdf} download><Icon name="download" />{c.pdf}</a>
    </div>
  </div>

  <main id="main" class="sheet">
    <aside class="aside">
      <Image class="photo" src={portrait} alt={t.hero.portraitAlt} widths={[240]} sizes="120px" />

      <section>
        <h2>Contact</h2>
        <ul class="contact">
          <li><Icon name="mail" /><a href={`mailto:${links.email}`}>{links.email}</a></li>
          <li><Icon name="globe" /><a href={`https://${site}${paths[lang].home}`}>{site}</a></li>
          <li><Icon name="linkedin" /><a href={links.linkedin}>in/guillaume-merle</a></li>
          <li><Icon name="github" /><a href={links.github}>GuillaumeM92</a></li>
          <li><Icon name="pin" /><span>{c.location}</span></li>
        </ul>
      </section>

      <section>
        <h2>{c.skillsTitle}</h2>
        {
          t.skills.groups.map((g) => (
            <div class="skill">
              <h3>{g.name}</h3>
              <p>{g.items.join(', ')}</p>
            </div>
          ))
        }
      </section>

      <section>
        <h2>{c.languagesTitle}</h2>
        <ul class="plain">
          {
            t.skills.languages.map((l) => (
              <li>
                <strong>{l.name}</strong> — {l.level}
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>{c.interestsTitle}</h2>
        <p class="small">{t.skills.interests.join(' · ')}</p>
      </section>
    </aside>

    <div class="content">
      <header class="head">
        <h1>Guillaume Merle</h1>
        <p class="headline">{c.headline}</p>
      </header>

      <section>
        <h2>{c.profileTitle}</h2>
        <p>{c.profile}</p>
      </section>

      <section>
        <h2>{c.experienceTitle}</h2>
        {
          jobs.map((job) => (
            <article class="job">
              <div class="job-head">
                <h3>{job.title}</h3>
                <span class="dates">
                  {job.start} – {job.end ?? t.experience.now}
                </span>
              </div>
              <p class="org">
                <strong>{job.org}</strong> · {job.kind} · {job.place}
              </p>
              <ul>
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
              {job.org === 'Freelance' && <p class="note">{job.summary}</p>}
            </article>
          ))
        }
      </section>

      <section>
        <h2>{c.educationTitle}</h2>
        <article class="job">
          <div class="job-head">
            <h3>{school.title}</h3>
            <span class="dates">{school.start} – {school.end}</span>
          </div>
          <p class="org"><strong>{school.org}</strong> · {school.kind} · {school.place}</p>
          <p class="small">{school.bullets.join(' · ')}</p>
        </article>
      </section>

      <section>
        <h2>{c.projectsTitle}</h2>
        <ul class="projects">
          {
            c.projects.map((p) => (
              <li>
                <strong><a href={p.url}>{p.name}</a></strong> — {p.text}
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </main>
</Base>

<style>
  :global(html body) {
    background: #0a111b;
  }

  .toolbar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.75rem var(--gutter);
    background: rgb(4 8 15 / 0.85);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* ---------- la feuille ---------- */

  .sheet {
    --paper: #ffffff;
    --text: #1b2733;
    --soft: #4b5c6b;
    --rule: #dbe3ea;
    --brand: #0a7c88;
    --side: #f2f6f9;

    display: grid;
    grid-template-columns: 64mm minmax(0, 1fr);
    width: 210mm;
    max-width: calc(100% - 2 * var(--gutter));
    min-height: 297mm;
    margin: 2rem auto 4rem;
    background: var(--paper);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 9.2pt;
    line-height: 1.45;
    box-shadow: 0 30px 80px -30px #000;
    border-radius: 4px;
    overflow: hidden;
  }

  .sheet a {
    color: inherit;
    text-decoration: none;
  }

  .sheet h1,
  .sheet h2,
  .sheet h3 {
    color: #0b1622;
  }

  .aside {
    display: grid;
    gap: 5.5mm;
    align-content: start;
    padding: 12mm 7mm 10mm 9mm;
    background: var(--side);
  }

  .photo {
    width: 30mm;
    height: 30mm;
    object-fit: cover;
    object-position: 50% 25%;
    border-radius: 50%;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px var(--rule);
  }

  h2 {
    margin-bottom: 2.5mm;
    padding-bottom: 1.2mm;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: 8pt;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand) !important;
  }

  .contact {
    display: grid;
    gap: 1.6mm;
    list-style: none;
    font-size: 8.4pt;
  }

  .contact li {
    display: flex;
    align-items: center;
    gap: 2mm;
    overflow-wrap: anywhere;
  }

  .contact :global(svg) {
    flex: none;
    width: 3.4mm;
    height: 3.4mm;
    color: var(--brand);
  }

  .skill + .skill {
    margin-top: 2mm;
  }

  .skill h3 {
    font-family: var(--font-body);
    font-size: 8.4pt;
    font-weight: 600;
    letter-spacing: 0;
  }

  .skill p,
  .small {
    color: var(--soft);
    font-size: 8.2pt;
  }

  .plain {
    display: grid;
    gap: 1mm;
    list-style: none;
    font-size: 8.4pt;
  }

  .content {
    display: grid;
    gap: 6mm;
    align-content: start;
    padding: 12mm 12mm 10mm 10mm;
  }

  .head h1 {
    font-size: 25pt;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .headline {
    margin-top: 2mm;
    font-family: var(--font-display);
    font-size: 11.5pt;
    font-weight: 500;
    color: var(--brand);
  }

  .job + .job {
    margin-top: 4.2mm;
  }

  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4mm;
  }

  .job h3 {
    font-family: var(--font-display);
    font-size: 10.5pt;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .dates {
    flex: none;
    font-size: 8pt;
    color: var(--soft);
    white-space: nowrap;
  }

  .org {
    margin: 0.5mm 0 1.2mm;
    color: var(--soft);
    font-size: 8.4pt;
  }

  .org strong {
    color: var(--text);
  }

  .job ul,
  .projects {
    display: grid;
    gap: 0.6mm;
    padding-left: 4mm;
  }

  .job li::marker,
  .projects li::marker {
    color: var(--brand);
  }

  .note {
    margin-top: 1mm;
    color: var(--soft);
    font-size: 8.2pt;
    font-style: italic;
  }

  .projects {
    gap: 1.2mm;
  }

  @media (max-width: 760px) {
    .sheet {
      grid-template-columns: 1fr;
      width: auto;
      min-height: 0;
      font-size: 10pt;
    }

    .aside {
      order: 2;
      padding: 8mm 7mm;
    }

    .content {
      padding: 8mm 7mm;
    }

    .job-head {
      flex-direction: column;
      gap: 0;
    }
  }

  @page {
    size: A4;
    margin: 0;
  }

  @media print {
    :global(html body) {
      background: #fff !important;
    }

    [data-print-hide],
    :global(.skip-link) {
      display: none !important;
    }

    .sheet {
      width: 210mm;
      max-width: none;
      min-height: 297mm;
      margin: 0;
      box-shadow: none;
      border-radius: 0;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
